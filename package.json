{
  "name": "vision-guard",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "start:tunnel": "expo start --tunnel",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "android:release": "expo run:android --variant release",
    "ios": "expo run:ios",
    "ios:release": "expo run:ios --configuration Release",
    "web": "expo start --web",
    "web:build": "expo export --platform web",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "build:all": "eas build --platform all",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "type-check": "tsc --noEmit",
    "clean": "expo install --fix && node -e \"const fs=require('fs'); fs.rmSync('node_modules/.cache', {recursive:true, force:true}); fs.rmSync('.metro-cache', {recursive:true, force:true});\"",
    "optimize": "npm run clean && npm run type-check && npm run lint:fix",
    "analyze": "npx react-native bundle --platform android --dev false --entry-file index.js --bundle-output android-bundle.js --analyze",
    "precommit": "npm run type-check && npm run lint"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/datetimepicker": "8.4.1",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-community/slider": "4.5.6",
    "@react-native-ml-kit/face-detection": "^2.0.1",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.6",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.2.3",
    "expo": "~53.0.27",
    "expo-background-fetch": "~13.1.6",
    "expo-blur": "~14.1.5",
    "expo-brightness": "~13.1.4",
    "expo-camera": "~16.1.11",
    "expo-clipboard": "~7.1.5",
    "expo-constants": "~17.1.7",
    "expo-crypto": "~14.1.5",
    "expo-dev-client": "~5.2.4",
    "expo-device": "^7.1.4",
    "expo-face-detector": "^13.0.2",
    "expo-font": "~13.3.2",
    "expo-haptics": "~14.1.4",
    "expo-image": "~2.4.1",
    "expo-intent-launcher": "^55.0.12",
    "expo-linking": "~7.1.7",
    "expo-local-authentication": "~16.0.5",
    "expo-media-library": "~17.1.7",
    "expo-notifications": "~0.31.5",
    "expo-random": "^14.0.1",
    "expo-router": "~5.1.11",
    "expo-secure-store": "~14.2.4",
    "expo-speech": "~13.1.7",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-symbols": "~0.4.5",
    "expo-task-manager": "~13.1.6",
    "expo-web-browser": "~14.2.0",
    "firebase": "^12.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-device-info": "^14.0.4",
    "react-native-dotenv": "^3.4.11",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-web": "~0.20.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/crypto-js": "^4.2.2",
    "@types/react": "~19.0.10",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~9.2.0",
    "expo-module-scripts": "^5.0.8",
    "typescript": "~5.8.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "crypto-js",
          "expo-face-detector",
          "expo-random",
          "firebase"
        ]
      }
    }
  },
  "private": true
}

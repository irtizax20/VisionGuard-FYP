<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="56dp"
    android:layout_height="56dp"
    android:background="@drawable/bg_floating_bubble">

    <!-- 1x1 invisible preview view required to bind camera lifecycle in background -->
    <androidx.camera.view.PreviewView
        android:id="@+id/hidden_preview"
        android:layout_width="1px"
        android:layout_height="1px"
        android:visibility="visible" />

    <!-- Small eye emoji label instead of large launcher icon -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="👁️"
        android:textSize="26sp"
        android:gravity="center"
        android:padding="4dp" />

</FrameLayout>
